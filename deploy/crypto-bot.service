[Unit]
Description=Crypto futures trading bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=cryptobot
Group=cryptobot
WorkingDirectory=/opt/crypto-bot
# Secrets live only in this file on the server (chmod 600, owned by cryptobot)
EnvironmentFile=/opt/crypto-bot/.env
ExecStart=/opt/crypto-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=10
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crypto-bot/state /opt/crypto-bot/reports /opt/crypto-bot/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
